<Window x:Class="Hotel_Pere_Maria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Button Content="Probar Conexión" Click="Button_Click" Margin="10"/>
            <ScrollViewer Height="200">
                <TextBlock x:Name="txtResultados" TextWrapping="Wrap" Background="#F0F0F0" Padding="10"/>
            </ScrollViewer>
        </StackPanel>

    </Grid>
</Window>
