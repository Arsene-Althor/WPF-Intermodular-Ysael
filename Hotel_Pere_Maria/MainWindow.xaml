<Window x:Class="Hotel_Pere_Maria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Hotel Pere Maria"
        Height="700" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F7"
        ResizeMode="NoResize">
    <Grid>
        <Border Background="White" CornerRadius="10" Padding="20" Margin="20" BorderBrush="#DDDDDD" BorderThickness="1" MaxWidth="400" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="350">

                <Image Source="/Resources/HotelLogo.png" Height="151" Width="286"/>

                <TextBlock Text="INICIO DE SESIÓN"
                FontSize="28"
                FontWeight="Bold"
                Margin="0,20,0,30"
                Foreground="#1f2121"
                HorizontalAlignment="Center"/>

                <TextBlock Text="Email" Foreground="#626c7c" Margin="0,0,0,5" FontSize="14" FontWeight="Bold"/>
                <TextBox x:Name="TxtEmail"
              Height="40"
              Padding="10"
              FontSize="14"
              Background="White"
              BorderThickness="1"
              BorderBrush="#d0d0d0"
              Margin="0,0,0,15"/>

                <TextBlock Text="Contraseña" Foreground="#626c7c" Margin="0,0,0,5" FontSize="14" FontWeight="Bold"/>
                <PasswordBox x:Name="TxtPassword" Height="40" Padding="10" FontSize="14" Background="White" BorderThickness="1" BorderBrush="#d0d0d0" Margin="0,0,0,10" Visibility="Visible"/>
                <TextBox x:Name="txtPasswordVisible" Height="40" Padding="10" FontSize="14" Background="White" BorderThickness="1" BorderBrush="#d0d0d0" Margin="0,0,0,10" Visibility="Collapsed" TextChanged="TexChanget_Contra"/>

                <CheckBox HorizontalAlignment="Right" x:Name="checkpass" Checked="CheckBox_Checked" Unchecked="CheckBox_Checked">Mostrar contraseña</CheckBox>

                <Button x:Name="BtnLogin" Margin="0,20,0,0" Content="Iniciar Sesión" Padding="12" Background="#27AE60" Foreground="White" FontWeight="Bold" Click="BtnLogin_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock x:Name="TxtError" Foreground="Red" TextWrapping="Wrap" Margin="0,15,0,0" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
