<UserControl x:Class="Hotel_Pere_Maria.Views.ConfigFlexibilidad"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="640" d:DesignWidth="920"
        Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceSubtle}" CornerRadius="10" Padding="12,10" Margin="0,0,0,16"
                BorderBrush="{StaticResource Brush.AccentMid}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Reglas check-in / check-out"/>
                    <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap"
                               Text="Tarifas €/h, acceso gratuito por rango, límites horarios y descuentos."/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Recargar" Style="{StaticResource NavChipButton}" Margin="0,0,8,0" Command="{Binding CargarCommand}"/>
                    <Button Content="Guardar" Style="{StaticResource NavChipButton}" Command="{Binding GuardarCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Brush.SurfaceElevated}" CornerRadius="12" Padding="20"
                BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760">
                    <TextBlock Text="Acceso gratuito (suplemento 0 €)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <CheckBox Content="Bronce" IsChecked="{Binding BronceGratis}" Margin="0,0,24,0"/>
                        <CheckBox Content="Plata" IsChecked="{Binding PlataGratis}" Margin="0,0,24,0"/>
                        <CheckBox Content="Oro" IsChecked="{Binding OroGratis}"/>
                    </StackPanel>

                    <TextBlock Text="Descuento sobre suplemento (%)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Bronce %" FontSize="11"/>
                            <TextBox Text="{Binding DtoBronce, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Text="Plata %" FontSize="11"/>
                            <TextBox Text="{Binding DtoPlata, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Oro %" FontSize="11"/>
                            <TextBox Text="{Binding DtoOro, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Tarifas (€/hora de diferencia)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Entrada anticipada (vs 12:00)" FontSize="11"/>
                            <TextBox Text="{Binding EarlyRatePerHour, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Salida tardía (vs 11:00)" FontSize="11"/>
                            <TextBox Text="{Binding LateRatePerHour, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Límites y facturación" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Horas mínimas facturables" FontSize="11"/>
                            <TextBox Text="{Binding MinBillableHours, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,8">
                            <TextBlock Text="Tope suplemento € (0 = sin tope)" FontSize="11"/>
                            <TextBox Text="{Binding MaxSupplementEur, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Hora mínima entrada anticipada" FontSize="11"/>
                            <TextBox Text="{Binding EarlyMinHour, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,8">
                            <TextBlock Text="Hora máxima salida tardía" FontSize="11"/>
                            <TextBox Text="{Binding LateMaxHour, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Máx. horas adelanto (vs 12:00)" FontSize="11"/>
                            <TextBox Text="{Binding MaxEarlyHours, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,8">
                            <TextBlock Text="Máx. horas retraso (vs 11:00)" FontSize="11"/>
                            <TextBox Text="{Binding MaxLateHours, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <CheckBox Content="Enviar email al cliente al aprobar o rechazar" IsChecked="{Binding NotifyClient}" Margin="0,8,0,0"/>

                    <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                               Text="Aprobación automática: plata y oro se aprueban al solicitar si hay hueco (variables FLEX_AUTO_APPROVE_SILVER/GOLD en el servidor). Bronce queda pendiente hasta revisión en recepción."/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
