<Window x:Class="Hotel_Pere_Maria.Views.AuditoriaReserva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Auditoría de reserva" Height="620" Width="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.PageBg}"
        d:DesignHeight="620" d:DesignWidth="620">
    <Border Margin="16" CornerRadius="12" Background="{StaticResource Brush.Surface}" Padding="16"
            BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.12" ShadowDepth="0"/>
        </Border.Effect>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{Binding TituloVentana}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock Text="Historial de cambios (solo lectura). Orden cronológico ascendente." Foreground="{StaticResource Brush.TextMuted}" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cerrar" Style="{StaticResource NavChipButton}" Padding="16,8" Command="{Binding CerrarCommand}"/>
            </StackPanel>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Filtrar por acción:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <ComboBox Width="220" VerticalAlignment="Center"
                              ItemsSource="{Binding FiltrosAccion}"
                              SelectedItem="{Binding FiltroAccionSeleccionado, Mode=TwoWay}"
                              Margin="0,0,12,0"/>
                    <Button Content="Actualizar" Style="{StaticResource NavChipButton}" Padding="12,6" Command="{Binding RefrescarHistorialCommand}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HistorialFilas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#3498DB" BorderThickness="4,0,0,0" Padding="12,10" Margin="0,0,0,10" Background="#FAFAFA" CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Accion}" FontWeight="Bold" FontSize="15" Foreground="#2C3E50"/>
                                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                            <Run Text="Actor: " FontWeight="SemiBold"/>
                                            <Run Text="{Binding ActorNombre, Mode=OneWay}"/>
                                            <Run Text=" (" FontWeight="SemiBold"/>
                                            <Run Text="{Binding ActorId, Mode=OneWay}"/>
                                            <Run Text=")" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding FechaFormateada}" Foreground="#7F8C8D" FontSize="12" Margin="0,4,0,0"/>
                                        <TextBlock Text="Resumen" FontWeight="SemiBold" Margin="0,10,0,4" FontSize="11"/>
                                        <TextBlock Text="{Binding ResumenTexto}" TextWrapping="Wrap" FontSize="12"/>
                                        <TextBlock Text="Antes / después por campo" FontWeight="SemiBold" Margin="0,12,0,6" FontSize="11"
                                                   Visibility="{Binding TieneDetalleCambios, Converter={StaticResource BoolToVis}}"/>
                                        <DataGrid ItemsSource="{Binding Cambios}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                  CanUserAddRows="False" MaxHeight="200" FontSize="11"
                                                  Visibility="{Binding TieneDetalleCambios, Converter={StaticResource BoolToVis}}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Campo" Binding="{Binding Etiqueta}" Width="140"/>
                                                <DataGridTextColumn Header="Antes" Binding="{Binding Antes}" Width="*"/>
                                                <DataGridTextColumn Header="Después" Binding="{Binding Despues}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>
