<Window x:Class="Hotel_Pere_Maria.Views.GestionUsuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Usuarios" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F5F6F7">

    <!-- ============================================================
         MVVM: Ya NO usamos Click="..." ni x:Name="..." para la lógica.
         En su lugar usamos:
           - Text="{Binding Propiedad}"           → para TextBox
           - SelectedIndex="{Binding Propiedad}"   → para ComboBox
           - SelectedDate="{Binding Propiedad}"    → para DatePicker
           - Command="{Binding NombreCommand}"     → para Button
           - ItemsSource="{Binding Lista}"         → para DataGrid
           - SelectedItem="{Binding Seleccionado}" → para DataGrid

         El DataContext se asigna en el code-behind (GestionUsuarios.xaml.cs)
         y apunta al GestionUsuariosViewModel.
         ============================================================ -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Gestión Integral de Usuarios" FontSize="24" FontWeight="Bold" 
                   Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Primera fila de filtros -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">

                <StackPanel Margin="5">
                    <TextBlock Text="DNI:" FontWeight="SemiBold" FontSize="11"/>
                    <!-- MVVM: Bindeamos Text a FiltroDNI del ViewModel.
                         UpdateSourceTrigger=PropertyChanged hace que filtre letra a letra -->
                    <TextBox Width="100" Padding="4"
                             Text="{Binding FiltroDNI, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Nombre:" FontWeight="SemiBold" FontSize="11"/>
                    <TextBox Width="100" Padding="4"
                             Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Apellido:" FontWeight="SemiBold" FontSize="11"/>
                    <TextBox Width="100" Padding="4"
                             Text="{Binding FiltroApellido, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Email:" FontWeight="SemiBold" FontSize="11"/>
                    <TextBox Width="140" Padding="4"
                             Text="{Binding FiltroEmail, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Ciudad:" FontWeight="SemiBold" FontSize="11"/>
                    <TextBox Width="100" Padding="4"
                             Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Margin="10,5,5,5">
                    <TextBlock Text="Rol:" FontWeight="SemiBold" FontSize="11"/>
                    <!-- MVVM: Bindeamos SelectedIndex al ViewModel -->
                    <ComboBox Width="110" Padding="4"
                              SelectedIndex="{Binding FiltroRolIndex}">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Admin"/>
                        <ComboBoxItem Content="Empleado"/>
                        <ComboBoxItem Content="Cliente"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Estado:" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox Width="90" Padding="4"
                              SelectedIndex="{Binding FiltroEstadoIndex}">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Activos"/>
                        <ComboBoxItem Content="Inactivos"/>
                    </ComboBox>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- Segunda fila de filtros -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">

                <StackPanel Margin="5">
                    <TextBlock Text="VIP:" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox Width="90" Padding="4"
                              SelectedIndex="{Binding FiltroVIPIndex}">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Solo VIP"/>
                        <ComboBoxItem Content="No VIP"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Género:" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox Width="100" Padding="4"
                              SelectedIndex="{Binding FiltroGeneroIndex}">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Masculino"/>
                        <ComboBoxItem Content="Femenino"/>
                        <ComboBoxItem Content="Otro"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Descuento:" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox Width="120" Padding="4"
                              SelectedIndex="{Binding FiltroDescuentoIndex}">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Con descuento"/>
                        <ComboBoxItem Content="Sin descuento"/>
                        <ComboBoxItem Content="10% o más"/>
                        <ComboBoxItem Content="20% o más"/>
                        <ComboBoxItem Content="30% o más"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="15,5,5,5">
                    <TextBlock Text="Registrado desde:" FontWeight="SemiBold" FontSize="11"/>
                    <DatePicker Width="120"
                                SelectedDate="{Binding FiltroFechaDesde}"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Registrado hasta:" FontWeight="SemiBold" FontSize="11"/>
                    <DatePicker Width="120"
                                SelectedDate="{Binding FiltroFechaHasta}"/>
                </StackPanel>

                <!-- MVVM: Command en vez de Click -->
                <Button Content="🧹 Limpiar Filtros"
                        Command="{Binding LimpiarFiltrosCommand}"
                        Background="#95A5A6" Foreground="White" Padding="10,5" Margin="20,15,5,5" 
                        VerticalAlignment="Bottom" Height="28"/>

            </WrapPanel>
        </Border>

        <!-- Botones de acción -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button Content="🔄 Recargar" Command="{Binding RecargarCommand}" Background="#3498DB" Foreground="White" Padding="10,5" Margin="5"/>
            <Button Content="💸 Descuento" Command="{Binding GestionarDescuentoCommand}" Background="#8E44AD" Foreground="White" Padding="10,5" Margin="5"/>
            <Button Content="➕ Nuevo Usuario" Command="{Binding NuevoUsuarioCommand}" Background="#27AE60" Foreground="White" Padding="10,5" Margin="5"/>
            <Button Content="✏️ Editar" Command="{Binding EditarUsuarioCommand}" Background="#F39C12" Foreground="White" Padding="10,5" Margin="5"/>
            <Button Content="🗑️ Eliminar" Command="{Binding EliminarUsuarioCommand}" Background="#E74C3C" Foreground="White" Padding="10,5" Margin="5"/>
        </StackPanel>

        <!-- DataGrid -->
        <!-- MVVM: ItemsSource y SelectedItem via Binding -->
        <DataGrid Grid.Row="4" x:Name="dgUsuarios" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" RowHeight="35" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                  ItemsSource="{Binding UsuariosFiltrados}"
                  SelectedItem="{Binding UsuarioSeleccionado}"
                  MouseDoubleClick="dgUsuarios_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding user_id}" Width="75"/>
                <DataGridTextColumn Header="DNI" Binding="{Binding dni}" Width="85"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding name}" Width="90"/>
                <DataGridTextColumn Header="Apellido" Binding="{Binding surname}" Width="90"/>
                <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="150"/>
                <DataGridTextColumn Header="Ciudad" Binding="{Binding city}" Width="80"/>
                <DataGridTextColumn Header="Género" Binding="{Binding GenderDisplay}" Width="70"/>
                <DataGridTextColumn Header="Rol" Binding="{Binding role}" Width="65"/>
                <DataGridTextColumn Header="VIP" Binding="{Binding VIPDisplay}" Width="55"/>
                <DataGridTextColumn Header="Dto." Binding="{Binding DiscountDisplay}" Width="45" FontWeight="Bold" Foreground="#27AE60"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding StatusDisplay}" Width="60"/>
                <DataGridTextColumn Header="Registro" Binding="{Binding createdAt, StringFormat=dd/MM/yyyy}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>