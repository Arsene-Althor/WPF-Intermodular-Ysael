<Window x:Class="Hotel_Pere_Maria.Views.GestionUsuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Usuarios" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F5F6F7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Gestión Integral de Usuarios" FontSize="24" FontWeight="Bold" 
                   Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">

                <StackPanel Margin="5">
                    <TextBlock Text="Filtrar por DNI:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtFiltroDNI" Width="120" TextChanged="FiltrarUsuarios_TextChanged" Padding="4"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Filtrar por Apellido:" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtFiltroApellido" Width="120" TextChanged="FiltrarUsuarios_TextChanged" Padding="4"/>
                </StackPanel>

                <StackPanel Margin="20,5,5,5">
                    <TextBlock Text="Tipo de Usuario:" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cbFiltroRol" Width="150" SelectionChanged="FiltrarUsuarios_TextChanged" SelectedIndex="0" Padding="4">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Clientes (CLI)"/>
                        <ComboBoxItem Content="Empleados (EMP/ADM)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Margin="20,5,5,5">
                    <TextBlock Text="Estado:" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cbFiltroEstado" Width="120" SelectionChanged="FiltrarUsuarios_TextChanged" SelectedIndex="0" Padding="4">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Activos"/>
                        <ComboBoxItem Content="Inactivos"/>
                    </ComboBox>
                </StackPanel>

            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button Content="🔄 Recargar Lista" Click="Click_RecargarUsuarios" Background="#3498DB" Foreground="White" Padding="10,5" Margin="5"/>
            <Button Content="💸 Descuento" Click="Click_GestionarDescuento" Background="#8E44AD" Foreground="White" Padding="10,5" Margin="5"/>
            <Button Content="➕ Nuevo Usuario" Click="Click_NuevoUsuario" Background="#27AE60" Foreground="White" Padding="10,5" Margin="5"/>
            <Button Content="✏️ Editar Seleccionado" Click="Click_EditarUsuario" Background="#F39C12" Foreground="White" Padding="10,5" Margin="5"/>
            <Button Content="🗑️ Eliminar Usuario" Click="Click_EliminarUsuario" Background="#E74C3C" Foreground="White" Padding="10,5" Margin="5"/>
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="dgUsuarios" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" RowHeight="35" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                  MouseDoubleClick="dgUsuarios_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding user_id}" Width="80"/>
                <DataGridTextColumn Header="DNI" Binding="{Binding dni}" Width="100"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding name}" Width="*"/>
                <DataGridTextColumn Header="Apellido" Binding="{Binding surname}" Width="*"/>
                <DataGridTextColumn Header="Descuento" Binding="{Binding DiscountDisplay}" Width="80" FontWeight="Bold" Foreground="#27AE60"/>
                <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="150"/>
                <DataGridTextColumn Header="Rol" Binding="{Binding role}" Width="80"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding StatusDisplay}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>