<Window x:Class="Hotel_Pere_Maria.Views.PerfilUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mi Perfil" Height="500" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F5F6F7">

    <Border Background="White" Margin="20" CornerRadius="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="2"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Mi Perfil" FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>

            <Border Width="120" Height="120" CornerRadius="60" BorderThickness="2" BorderBrush="#3498DB" Margin="0,0,0,10">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding ImagenPerfil}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <Button Content="📷 Cambiar Foto" Command="{Binding CambiarFotoCommand}" 
                    Background="Transparent" BorderThickness="0" Foreground="#3498DB" 
                    Cursor="Hand" Margin="0,0,0,20" FontWeight="Bold"/>

            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Nombre:" FontWeight="Bold" Grid.Row="0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding NombreCompleto}" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>

                <TextBlock Text="Email:" FontWeight="Bold" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Email}" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>

                <TextBlock Text="Rol:" FontWeight="Bold" Grid.Row="2" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Rol}" Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>

                <TextBlock Text="ID:" FontWeight="Bold" Grid.Row="3" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding UserId}" Grid.Row="3" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <Button Content="Cerrar" Command="{Binding CerrarCommand}" Width="100" Height="35" Margin="0,20,0,0"
                    Background="#95A5A6" Foreground="White" FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </Border>
</Window>