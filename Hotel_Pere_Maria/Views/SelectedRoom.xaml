<Window x:Class="Hotel_Pere_Maria.Views.SelectedRoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria.Views"
        mc:Ignorable="d"
        Title="SelectedRoom" Height="450" Width="800">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Info -->
            <RowDefinition Height="Auto"/>
            <!-- Tabla -->
            <RowDefinition Height="*"/>
            <!-- Botones -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Texto informativo -->
        <TextBlock x:Name="txtInfo"
                   Grid.Row="0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"
                   Text="Habitaciones disponibles"/>

        <!-- DataGrid de habitaciones -->
        <DataGrid x:Name="dgRooms"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  Margin="0,0,0,10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding RoomId}"
                                    Width="*" />

                <DataGridTextColumn Header="Tipo"
                                    Binding="{Binding Type}"
                                    Width="*" />

                <DataGridTextColumn Header="Precio / Noche"
                                    Binding="{Binding PricePerNight}"
                                    Width="*" />

                <DataGridTextColumn Header="Máx. Personas"
                                    Binding="{Binding MaxOccupancy}"
                                    Width="*" />

                <DataGridTextColumn Header="Valoración"
                                    Binding="{Binding Rate}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botones -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Seleccionar"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="BtnSeleccionar_Click"/>

            <Button Content="Cancelar"
                    Width="120"
                    Click="BtnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>
