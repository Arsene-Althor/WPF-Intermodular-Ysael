<Window x:Class="Hotel_Pere_Maria.Views.modReserva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria.Views"
        mc:Ignorable="d"
        Title="Modificar Reserva" Height="650" Width="600"
        WindowStartupLocation="CenterScreen" Background="#F5F6F7"
        >
    <Border CornerRadius="20" ClipToBounds="True">

        <Grid>
            <StackPanel Margin="25">
                <TextBlock x:Name="nReserva" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" FontFamily="Segoe UI Black">Modificar Reserva: </TextBlock>

                <Border Background="White" CornerRadius="12" Padding="15" Margin="10,0,10,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="DATOS GENERALES" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="ID Habitación" FontSize="11"/>
                        <TextBox x:Name="txtRoomId" Margin="0,5,0,0" Height="30" VerticalContentAlignment="Center" TextChanged="RecalcularPrecio"/>

                        <TextBlock Text="ID Cliente" FontSize="11"/>
                        <TextBox x:Name="txtUserId" Margin="0,5,0,15" Height="30" VerticalContentAlignment="Center" TextChanged="RecalcularPrecio" MouseDoubleClick="dbClick_SelectUser"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="15" Margin="10,0,10,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="PERÍODO DE ESTANCIA" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Check-In" FontSize="11"/>
                                <DatePicker x:Name="dpCheckIn" Margin="0,5" SelectedDateChanged="RecalcularPrecio"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Check-Out" FontSize="11"/>
                                <DatePicker x:Name="dpCheckOut" Margin="0,5" SelectedDateChanged="RecalcularPrecio"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Content="CANCELAR ESTA RESERVA" Click="Click_CancelarReserva" 
                        Background="#E74C3C" Foreground="White" BorderBrush="Black"
                        BorderThickness="1" Height="35" Cursor="Hand" Margin="10,0,10,20">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Border Background="White" CornerRadius="12" Padding="15" Margin="10,0,10,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
                    </Border.Effect>
                    <DockPanel>
                        <TextBlock Text="PRECIO RECALCULADO" VerticalAlignment="Center" Foreground="White" FontSize="12" Opacity="0.7"/>
                        <TextBlock x:Name="lblPrecioFinal" Text="0.00€" DockPanel.Dock="Right" 
                                   HorizontalAlignment="Right" FontSize="26" FontWeight="Bold" Foreground="#2ECC71"/>
                    </DockPanel>
                </Border>

                <UniformGrid Columns="2" Margin="10,0,10,20">
                    <Button Content="GUARDAR CAMBIOS" Click="Click_Guardar" Margin="5" Height="40" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="1" BorderBrush="Black">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="CANCELAR" Click="Click_Cancelar" Margin="5" Height="40" 
                            Background="#E74C3C" Foreground="White" BorderThickness="1" BorderBrush="Black">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </Border>

</Window>
