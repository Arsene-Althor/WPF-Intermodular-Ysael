<Window x:Class="Hotel_Pere_Maria.Views.modReserva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria.Views"
        mc:Ignorable="d"
        Title="Modificar Reserva" Height="720" Width="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Brush.PageBg}"
        >
    <Border CornerRadius="20" ClipToBounds="True" VerticalAlignment="Stretch">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                           FontFamily="Segoe UI Black"
                           Text="{Binding ReservationId, StringFormat='Modificar Reserva: {0}'}"/>
                <Button Grid.Column="1" Content="Historial de auditoría" VerticalAlignment="Center"
                        Command="{Binding IrHistorialCommand}" Padding="14,8" Cursor="Hand"
                        Background="#3498DB" Foreground="White" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Datos">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                        <StackPanel Margin="15">
                            <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="DATOS GENERALES" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                                    <TextBlock Text="ID Habitación" FontSize="11"/>
                                    <TextBox Margin="0,5,0,0" Height="30" VerticalContentAlignment="Center" Text="{Binding RoomId, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SeleccionarHabitacionCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <TextBlock Text="ID Cliente" FontSize="11"/>
                                    <TextBox Margin="0,5,0,15" Height="30" VerticalContentAlignment="Center" Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SeleccionarClienteCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="PERÍODO DE ESTANCIA" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Check-In" FontSize="11"/>
                                            <DatePicker Margin="0,5" SelectedDate="{Binding CheckIn}" IsEnabled="{Binding CheckInEnabled}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Check-Out" FontSize="11"/>
                                            <DatePicker Margin="0,5" SelectedDate="{Binding CheckOut}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Content="CANCELAR ESTA RESERVA" Command="{Binding CancelarReservaCommand}"
                                    Background="#E74C3C" Foreground="White" BorderBrush="Black"
                                    BorderThickness="1" Height="35" Cursor="Hand" Margin="0,0,0,16">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Border Background="#EBF5FB" CornerRadius="12" Padding="15" Margin="0,0,0,16"
                                    BorderBrush="#3498DB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="JUSTIFICANTE DE RESERVA (PDF)" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Documento no fiscal: confirmación de la reserva y pago simulado. El cliente puede mostrarlo en recepción." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
                                    <Button Content="Descargar justificante (PDF)" Command="{Binding DescargarJustificanteCommand}"
                                            Background="#3498DB" Foreground="White" Height="36" Cursor="Hand" HorizontalAlignment="Left" Padding="16,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Background="#E8F6F3" CornerRadius="12" Padding="15" Margin="0,0,0,16"
                                    BorderBrush="#1ABC9C" BorderThickness="1"
                                    Visibility="{Binding HasInvoice, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="FACTURA (PDF)" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock FontSize="12" Margin="0,0,0,10">
                                        <Run Text="Nº factura: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding InvoiceNumberDisplay, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                    <Button Content="Descargar factura (PDF)" Command="{Binding DescargarFacturaCommand}"
                                            Background="#16A085" Foreground="White" Height="36" Cursor="Hand" HorizontalAlignment="Left" Padding="16,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Background="#F4ECF7" CornerRadius="12" Padding="15" Margin="0,0,0,16"
                                    BorderBrush="#8E44AD" BorderThickness="1"
                                    Visibility="{Binding MostrarSolicitudesEspeciales, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="SOLICITUDES CHECK-IN / CHECK-OUT" FontSize="10" FontWeight="Bold" DockPanel.Dock="Left"/>
                                        <Button Content="Actualizar" DockPanel.Dock="Right" Padding="10,4" FontSize="11"
                                                Command="{Binding RefrescarFlexCommand}" Cursor="Hand"/>
                                    </DockPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8">
                                        <Run Text="Entrada antes de las 12:00 o salida después de las 11:00 (mismo día). Rango: "/>
                                        <Run Text="{Binding ClienteFidelidadTier, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>

                                    <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Check-in anticipado" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Sin solicitud registrada." FontSize="12" Foreground="#7F8C8D" Margin="0,8,0,0"
                                                       Visibility="{Binding SinEarly, Converter={StaticResource BoolToVis}}"/>
                                            <StackPanel Visibility="{Binding TieneEarly, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Margin="0,6,0,0" FontSize="12">
                                                    <Run Text="Estado: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding EarlyRequest.StatusLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Margin="0,4,0,0">
                                                    <Run Text="Hora: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding EarlyRequest.RequestedTimeText, Mode=OneWay}"/>
                                                    <Run Text="  Horas: "/>
                                                    <Run Text="{Binding EarlyRequest.HoursText, Mode=OneWay}"/>
                                                    <Run Text="  Suplemento: "/>
                                                    <Run Text="{Binding EarlyRequest.FeeText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#566573" Margin="0,4,0,0"
                                                           Text="{Binding EarlyRequest.AvailabilityLabel, Mode=OneWay}"/>
                                                <TextBlock FontSize="11" Foreground="#566573" Margin="0,2,0,0"
                                                           Text="{Binding EarlyRequest.ApprovalLabel, Mode=OneWay}"/>
                                                <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Text="{Binding EarlyRequest.ReviewNoteDisplay, Mode=OneWay}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                            Visibility="{Binding PuedeRevisarEarly, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="Aprobar" Background="#27AE60" Foreground="White" Padding="14,6" Margin="0,0,8,0"
                                                            Command="{Binding AprobarEarlyCommand}" Cursor="Hand"/>
                                                    <Button Content="Rechazar" Background="#C0392B" Foreground="White" Padding="14,6"
                                                            Command="{Binding RechazarEarlyCommand}" Cursor="Hand"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="White" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Check-out tardío" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text="Sin solicitud registrada." FontSize="12" Foreground="#7F8C8D" Margin="0,8,0,0"
                                                       Visibility="{Binding SinLate, Converter={StaticResource BoolToVis}}"/>
                                            <StackPanel Visibility="{Binding TieneLate, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Margin="0,6,0,0" FontSize="12">
                                                    <Run Text="Estado: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding LateRequest.StatusLabel, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Margin="0,4,0,0">
                                                    <Run Text="Hora: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding LateRequest.RequestedTimeText, Mode=OneWay}"/>
                                                    <Run Text="  Horas: "/>
                                                    <Run Text="{Binding LateRequest.HoursText, Mode=OneWay}"/>
                                                    <Run Text="  Suplemento: "/>
                                                    <Run Text="{Binding LateRequest.FeeText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#566573" Margin="0,4,0,0"
                                                           Text="{Binding LateRequest.AvailabilityLabel, Mode=OneWay}"/>
                                                <TextBlock FontSize="11" Foreground="#566573" Margin="0,2,0,0"
                                                           Text="{Binding LateRequest.ApprovalLabel, Mode=OneWay}"/>
                                                <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Text="{Binding LateRequest.ReviewNoteDisplay, Mode=OneWay}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                            Visibility="{Binding PuedeRevisarLate, Converter={StaticResource BoolToVis}}">
                                                    <Button Content="Aprobar" Background="#27AE60" Foreground="White" Padding="14,6" Margin="0,0,8,0"
                                                            Command="{Binding AprobarLateCommand}" Cursor="Hand"/>
                                                    <Button Content="Rechazar" Background="#C0392B" Foreground="White" Padding="14,6"
                                                            Command="{Binding RechazarLateCommand}" Cursor="Hand"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="#FEF9E7" CornerRadius="12" Padding="15" Margin="0,0,0,16"
                                    BorderBrush="#F39C12" BorderThickness="1"
                                    Visibility="{Binding CanRegistrarCheckout, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="CHECKOUT (personal)" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Tras la fecha de salida puede emitirse la factura en la API." TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"/>
                                    <Button Content="Registrar checkout y emitir factura" Command="{Binding RegistrarCheckoutCommand}"
                                            Background="#E67E22" Foreground="White" Height="36" Cursor="Hand" HorizontalAlignment="Left" Padding="16,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
                                </Border.Effect>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock FontSize="10" FontWeight="Bold">PRECIO ACTUAL</TextBlock>
                                        <TextBlock Text="{Binding PrecioOriginal, StringFormat={}{0:N2}€}" HorizontalAlignment="Right" FontSize="26" FontWeight="Bold" Foreground="#FFCC9B2E"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock HorizontalAlignment="Right" FontSize="10" FontWeight="Bold">PRECIO NUEVO</TextBlock>
                                        <TextBlock Text="{Binding PrecioNuevo, StringFormat={}{0:N2}€}" HorizontalAlignment="Right" FontSize="26" FontWeight="Bold" Foreground="#2ECC71"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <UniformGrid Columns="2">
                                <Button Content="GUARDAR CAMBIOS" Command="{Binding GuardarCommand}" Margin="5" Height="40" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="1" BorderBrush="Black">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="CERRAR" Command="{Binding CerrarCommand}" Margin="5" Height="40"
                                        Background="#E74C3C" Foreground="White" BorderThickness="1" BorderBrush="Black">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Historial (auditoría)">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Filtrar por acción:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                            <ComboBox Width="220" VerticalAlignment="Center"
                                      ItemsSource="{Binding FiltrosAccion}"
                                      SelectedItem="{Binding FiltroAccionSeleccionado, Mode=TwoWay}"
                                      Margin="0,0,12,0"/>
                            <Button Content="Actualizar" Padding="12,4" Command="{Binding RefrescarHistorialCommand}" Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#7F8C8D" FontSize="11" Margin="0,0,0,8"
                                   Text="Línea de tiempo de cambios (más antiguo arriba). El actor se resuelve con el listado de usuarios de la API."/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding HistorialFilas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#3498DB" BorderThickness="4,0,0,0" Padding="12,10" Margin="0,0,0,10" Background="White" CornerRadius="6">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" Opacity="0.35" ShadowDepth="1"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Accion}" FontWeight="Bold" FontSize="15" Foreground="#2C3E50"/>
                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                                    <Run Text="Actor: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding ActorNombre, Mode=OneWay}"/>
                                                    <Run Text=" (" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding ActorId, Mode=OneWay}"/>
                                                    <Run Text=")" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FechaFormateada}" Foreground="#7F8C8D" FontSize="12" Margin="0,4,0,0"/>
                                                <TextBlock Text="Resumen" FontWeight="SemiBold" Margin="0,10,0,4" FontSize="11"/>
                                                <TextBlock Text="{Binding ResumenTexto}" TextWrapping="Wrap" FontSize="12"/>
                                                <TextBlock Text="Antes / después por campo" FontWeight="SemiBold" Margin="0,12,0,6" FontSize="11"
                                                           Visibility="{Binding TieneDetalleCambios, Converter={StaticResource BoolToVis}}"/>
                                                <ItemsControl ItemsSource="{Binding Cambios}"
                                                              ItemTemplate="{StaticResource AuditCambioFilaDetalleTemplate}"
                                                              Visibility="{Binding TieneDetalleCambios, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>

</Window>
