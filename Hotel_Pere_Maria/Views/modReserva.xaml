<Window x:Class="Hotel_Pere_Maria.Views.modReserva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria.Views"
        mc:Ignorable="d"
        Title="modReserva" Height="550" Width="800">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="nReserva" Text="Editar Reserva: " FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <GroupBox Header="Información del Cliente" Margin="0,0,0,10" Padding="10">
                <StackPanel>
                    <TextBlock Text="ID Cliente:"/>
                    <TextBox x:Name="txtUserId" Margin="0,5" TextChanged="RecalcularPrecio"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Habitación" Margin="0,0,0,10" Padding="10">
                <StackPanel>
                    <TextBlock Text="ID Habitación:"/>
                    <TextBox x:Name="txtRoomId" Margin="0,5" TextChanged="RecalcularPrecio"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Estancia (Ampliar/Reducir)" Margin="0,0,0,10" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                        <TextBlock Text="Check-In:"/>
                        <DatePicker x:Name="dpCheckIn" SelectedDateChanged="RecalcularPrecio"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="Check-Out:"/>
                        <DatePicker x:Name="dpCheckOut" SelectedDateChanged="RecalcularPrecio"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
                <TextBlock Text="Precio Total: " FontSize="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="lblPrecioFinal" Text="0.00€" FontSize="22" FontWeight="Bold" Foreground="DarkGreen"/>
            </StackPanel>

            <UniformGrid Columns="2" Margin="0,10,0,0">
                <Button Content="Guardar Cambios" Click="Click_Guardar" Margin="5" Padding="10" Background="LightBlue"/>
                <Button Content="Cancelar" Click="Click_Cancelar" Margin="5" Padding="10"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
