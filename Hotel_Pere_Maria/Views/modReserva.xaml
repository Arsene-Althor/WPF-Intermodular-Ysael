<Window x:Class="Hotel_Pere_Maria.Views.modReserva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria.Views"
        mc:Ignorable="d"
        Title="Modificar Reserva" Height="720" Width="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Brush.PageBg}"
        >
    <Border CornerRadius="20" ClipToBounds="True" VerticalAlignment="Stretch">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                           FontFamily="Segoe UI Black"
                           Text="{Binding ReservationId, StringFormat='Modificar Reserva: {0}'}"/>
                <Button Grid.Column="1" Content="Historial de auditoría" VerticalAlignment="Center"
                        Command="{Binding IrHistorialCommand}" Padding="14,8" Cursor="Hand"
                        Background="#3498DB" Foreground="White" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="Datos">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                        <StackPanel Margin="15">
                            <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="DATOS GENERALES" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                                    <TextBlock Text="ID Habitación" FontSize="11"/>
                                    <TextBox Margin="0,5,0,0" Height="30" VerticalContentAlignment="Center" Text="{Binding RoomId, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SeleccionarHabitacionCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <TextBlock Text="ID Cliente" FontSize="11"/>
                                    <TextBox Margin="0,5,0,15" Height="30" VerticalContentAlignment="Center" Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SeleccionarClienteCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </StackPanel>
                            </Border>

                            <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="PERÍODO DE ESTANCIA" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Check-In" FontSize="11"/>
                                            <DatePicker Margin="0,5" SelectedDate="{Binding CheckIn}" IsEnabled="{Binding CheckInEnabled}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Check-Out" FontSize="11"/>
                                            <DatePicker Margin="0,5" SelectedDate="{Binding CheckOut}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Content="CANCELAR ESTA RESERVA" Command="{Binding CancelarReservaCommand}"
                                    Background="#E74C3C" Foreground="White" BorderBrush="Black"
                                    BorderThickness="1" Height="35" Cursor="Hand" Margin="0,0,0,16">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Border Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
                                </Border.Effect>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock FontSize="10" FontWeight="Bold">PRECIO ACTUAL</TextBlock>
                                        <TextBlock Text="{Binding PrecioOriginal, StringFormat={}{0:N2}€}" HorizontalAlignment="Right" FontSize="26" FontWeight="Bold" Foreground="#FFCC9B2E"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock HorizontalAlignment="Right" FontSize="10" FontWeight="Bold">PRECIO NUEVO</TextBlock>
                                        <TextBlock Text="{Binding PrecioNuevo, StringFormat={}{0:N2}€}" HorizontalAlignment="Right" FontSize="26" FontWeight="Bold" Foreground="#2ECC71"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <UniformGrid Columns="2">
                                <Button Content="GUARDAR CAMBIOS" Command="{Binding GuardarCommand}" Margin="5" Height="40" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="1" BorderBrush="Black">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="CERRAR" Command="{Binding CerrarCommand}" Margin="5" Height="40"
                                        Background="#E74C3C" Foreground="White" BorderThickness="1" BorderBrush="Black">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="10"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Historial (auditoría)">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Filtrar por acción:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                            <ComboBox Width="220" VerticalAlignment="Center"
                                      ItemsSource="{Binding FiltrosAccion}"
                                      SelectedItem="{Binding FiltroAccionSeleccionado, Mode=TwoWay}"
                                      Margin="0,0,12,0"/>
                            <Button Content="Actualizar" Padding="12,4" Command="{Binding RefrescarHistorialCommand}" Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#7F8C8D" FontSize="11" Margin="0,0,0,8"
                                   Text="Línea de tiempo de cambios (más antiguo arriba). El actor se resuelve con el listado de usuarios de la API."/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding HistorialFilas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#3498DB" BorderThickness="4,0,0,0" Padding="12,10" Margin="0,0,0,10" Background="White" CornerRadius="6">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="8" Opacity="0.35" ShadowDepth="1"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Accion}" FontWeight="Bold" FontSize="15" Foreground="#2C3E50"/>
                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap">
                                                    <Run Text="Actor: " FontWeight="SemiBold"/>
                                                    <Run Text="{Binding ActorNombre, Mode=OneWay}"/>
                                                    <Run Text=" (" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding ActorId, Mode=OneWay}"/>
                                                    <Run Text=")" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FechaFormateada}" Foreground="#7F8C8D" FontSize="12" Margin="0,4,0,0"/>
                                                <TextBlock Text="Resumen de cambios" FontWeight="SemiBold" Margin="0,10,0,4" FontSize="11"/>
                                                <TextBlock Text="{Binding ResumenTexto}" TextWrapping="Wrap" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>

</Window>
