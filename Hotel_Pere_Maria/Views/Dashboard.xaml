<UserControl x:Class="Hotel_Pere_Maria.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Surface}" CornerRadius="12"
                BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1" Padding="18" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Panel de rendimiento de reservas" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"/>
                    <TextBlock Text="Tendencias, ocupación y comportamiento de clientes"
                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding MensajeDatos}" Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0" FontSize="11"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,10,0" BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                        <TextBlock Text="{Binding EtiquetaModoDatos}" FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModoDemo}" Value="True">
                                            <Setter Property="Foreground" Value="#8E44AD"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Button Style="{StaticResource NavChipButton}"
                            Content="{Binding TextoBotonModoDatos}"
                            Command="{Binding AlternarModoDatosCommand}"
                            Padding="12,8"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryActionButton}"
                            Content="Actualizar"
                            Command="{Binding ActualizarDatosMockCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <UniformGrid Columns="4" Margin="0,0,0,14">
                    <Border Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="14" Margin="0,0,10,0"
                            BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Temporada más alta" Foreground="{StaticResource Brush.TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding TemporadaTopId}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="14" Margin="0,0,10,0"
                            BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Habitación más solicitada" Foreground="{StaticResource Brush.TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding HabitacionMasSolicitada}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="14" Margin="0,0,10,0"
                            BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding ReservasCanceladasTitulo}" Foreground="{StaticResource Brush.TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding ReservasCanceladasPeriodo}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="#C0392B" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Hoy" Command="{Binding CambiarPeriodoReservasCommand}" CommandParameter="Hoy" Padding="8,4" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavChipButton}">
                                            <Setter Property="Opacity" Value="0.75"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsPeriodoHoy}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Background" Value="{StaticResource Brush.AccentPastelDeep}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="7 días" Command="{Binding CambiarPeriodoReservasCommand}" CommandParameter="7 días" Padding="8,4" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavChipButton}">
                                            <Setter Property="Opacity" Value="0.75"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsPeriodo7Dias}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Background" Value="{StaticResource Brush.AccentPastelDeep}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="30 días" Command="{Binding CambiarPeriodoReservasCommand}" CommandParameter="30 días" Padding="8,4" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavChipButton}">
                                            <Setter Property="Opacity" Value="0.75"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsPeriodo30Dias}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Background" Value="{StaticResource Brush.AccentPastelDeep}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="90 días" Command="{Binding CambiarPeriodoReservasCommand}" CommandParameter="90 días" Padding="8,4">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavChipButton}">
                                            <Setter Property="Opacity" Value="0.75"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EsPeriodo90Dias}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="Background" Value="{StaticResource Brush.AccentPastelDeep}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="14"
                            BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Tasa ocupación actual" Foreground="{StaticResource Brush.TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding TasaOcupacionActualTexto}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.AccentMid}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Brush.Surface}" CornerRadius="12"
                            BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1" Padding="16" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Usuarios por rango (Bronce / Plata / Oro)"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding DistribucionUsuarios}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Rango}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold"/>
                                            <ProgressBar Grid.Column="1" Height="18" Maximum="100" Value="{Binding Porcentaje}"
                                                         BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.AccentMid}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Rango}" Value="Bronce">
                                                                <Setter Property="Foreground" Value="#B08D57"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Rango}" Value="Plata">
                                                                <Setter Property="Foreground" Value="#8B9AA5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Rango}" Value="Oro">
                                                                <Setter Property="Foreground" Value="#D4AF37"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Grid.Column="2" Text="{Binding PorcentajeTexto}" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextMuted}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource Brush.Surface}" CornerRadius="12"
                            BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1" Padding="16" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Top habitaciones / tipos más demandados"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,14"/>
                            <ItemsControl ItemsSource="{Binding HabitacionesTopDemanda}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Habitacion}" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap"/>
                                            <ProgressBar Grid.Column="1" Height="16" Maximum="100" Value="{Binding PorcentajeEscala}"
                                                         Foreground="{StaticResource Brush.AccentPastelDeep}"
                                                         BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Reservas}" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextMuted}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{StaticResource Brush.Surface}" CornerRadius="12"
                        BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Ingresos mensuales (últimos 6 meses)"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding IngresosMensuales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Mes}" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.TextPrimary}" FontWeight="SemiBold"/>
                                        <ProgressBar Grid.Column="1" Height="16" Maximum="100" Value="{Binding PorcentajeEscala}"
                                                     Foreground="{StaticResource Brush.AccentMid}"
                                                     BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1"/>
                                        <TextBlock Grid.Column="2" Text="{Binding IngresoTexto}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource Brush.TextMuted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="4">
                    <Border Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="14" Margin="0,0,10,0"
                            BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Ingresos mes actual" Foreground="{StaticResource Brush.TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding IngresosMesActualTexto}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="14" Margin="0,0,10,0"
                            BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Promedio estancia" Foreground="{StaticResource Brush.TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding PromedioEstanciaDiasTexto}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="14" Margin="0,0,10,0"
                            BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Tasa de no-show" Foreground="{StaticResource Brush.TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding TasaNoShowTexto, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" Margin="0,6,0,0"/>
                            <TextBlock Text="Reservas con ausencia sin aviso" FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="14"
                            BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Check-ins pendientes hoy" Foreground="{StaticResource Brush.TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding CheckInsPendientesHoy, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" Margin="0,6,0,0"/>
                            <TextBlock Text="Entradas aún no registradas en recepción" FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
