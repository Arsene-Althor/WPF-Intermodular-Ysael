<Window x:Class="Hotel_Pere_Maria.Views.Inicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria.Views"
        mc:Ignorable="d"
        Title="Inicio" Height="450" Width="800">
    <Grid >
        <DockPanel>

            <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="5">
                <MenuItem Header="Usuarios" FontSize="14" Padding="10,5">
                    <MenuItem Header="Gestionar Usuarios" x:Name="menuUsuarios" />
                </MenuItem>

                <MenuItem Header="Habitaciones" FontSize="14" Padding="10,5">
                    <MenuItem Header="Ver Disponibilidad" x:Name="menuHabitaciones" />
                </MenuItem>

                <MenuItem Header="Reservas" FontSize="14" Padding="10,5">
                    <MenuItem Header="Añadir reserva" Click="click_abriraddReserva" />
                    <MenuItem Header="Lista de reservas"/>
                </MenuItem>

                <MenuItem Header="Cerrar Sesión" Foreground="Red" HorizontalAlignment="Right"/>
            </Menu>

            <Grid x:Name="MainContent" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Bienvenido al Sistema de Gestión" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="Panel de control de reservas y clientes" FontSize="14" Foreground="Gray"/>
                    </StackPanel>
                    <Button Click="Iniciar_Ventana" Width="40" Height="40" HorizontalAlignment="Right" Margin="0,0,30,0" Background="Transparent" BorderBrush="Transparent">
                        <Image Source="/Resources/565469 (1).png" ></Image>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="Segoe UI Black">Reservas Actuales</TextBlock>
                </Grid>



                <Border Grid.Row="2" CornerRadius="5" BorderBrush="#DDDDDD" BorderThickness="1" Background="#80FFFFFF">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Background>
                            <ImageBrush ImageSource="/Resources/HotelLogo.png" Stretch="Uniform" Opacity="0.3"/>
                        </ScrollViewer.Background>
                        <ItemsControl x:Name="listReservation" Margin="10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5" Height="100" CornerRadius="8" BorderThickness="1" BorderBrush="#999">
                                        <Border.Background>
                                            <SolidColorBrush Color="White"/>
                                        </Border.Background>

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding reservation_id}" FontWeight="Bold" FontSize="20" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding room_id}" FontSize="14" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding check_in}" FontSize="12" HorizontalAlignment="Center" Foreground="Green"/>
                                            <TextBlock Text="{Binding check_out}" FontSize="12" HorizontalAlignment="Center" Foreground="DarkRed"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>

    </Grid>
</Window>
