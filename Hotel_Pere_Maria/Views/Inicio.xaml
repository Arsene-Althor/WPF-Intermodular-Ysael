<Window x:Class="Hotel_Pere_Maria.Views.Inicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hotel Pere Maria — Panel"
        WindowState="Maximized"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.PageBg}">
    <DockPanel>
        <!-- Barra superior: navegación en la misma ventana (sin apilar menús principales) -->
        <Border DockPanel.Dock="Top" Padding="16,12" BorderThickness="0,0,0,2"
                BorderBrush="{StaticResource Brush.AccentMid}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FDFEFF" Offset="0"/>
                    <GradientStop Color="#E2EEF9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Hotel Pere Maria" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="{StaticResource Brush.AccentPastelDeep}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center" Opacity="0.95">
                        <TextBlock Text="Gestión" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="← Panel"
                            Command="{Binding IrInicioCommand}"
                            Visibility="{Binding IsSubPageVisible, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource NavChipButton}" Content="Reservas" Command="{Binding AbrirAllReservasCommand}"/>
                    <Button Style="{StaticResource NavChipButton}" Content="Usuarios" Command="{Binding AbrirGestionUsuariosCommand}"/>
                    <Button Style="{StaticResource NavChipButton}" Content="Habitaciones" Command="{Binding AbrirAllRoomsCommand}"/>
                    <Button Style="{StaticResource NavChipButton}" Content="Facturas"
                            Command="{Binding AbrirFacturasCommand}"
                            Visibility="{Binding PuedeGestionFacturas, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource NavChipButton}" Content="Auditorías"
                            Command="{Binding AbrirAuditoriasCommand}"
                            Visibility="{Binding PuedeGestionFacturas, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource NavChipButton}" Content="Datos factura"
                            Command="{Binding AbrirConfigFacturaCommand}"
                            Visibility="{Binding PuedeGestionFacturas, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource NavChipButton}" Content="Reglas solicitudes"
                            Command="{Binding AbrirConfigFlexCommand}"
                            Visibility="{Binding PuedeGestionFacturas, Converter={StaticResource BoolToVis}}"/>
                    <Rectangle Width="1" Height="22" Fill="{StaticResource Brush.AccentBorder}" Margin="12,0"/>
                    <TextBlock Text="{Binding NombreUsuario, StringFormat='{}{0}'}" VerticalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource NavChipButton}" Content="Perfil" Command="{Binding AbrirPerfilCommand}" Padding="10,6"/>
                    <Button Style="{StaticResource NavChipButton}" Content="Salir" Command="{Binding CerrarSesionCommand}"
                            Foreground="#C0392B" BorderBrush="{StaticResource Brush.DangerSoft}" Padding="10,6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20" Background="{StaticResource Brush.PanelWash}">
            <Grid Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Command="{Binding CargarDatosCommand}" Width="40" Height="40"
                                Background="Transparent" BorderBrush="Transparent" ToolTip="Actualizar">
                            <Image Source="/Resources/565469 (1).png"/>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Panel de control" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"/>
                            <TextBlock Text="Reservas activas y accesos rápidos" FontSize="14"
                                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#F4ECF7" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                            BorderBrush="#8E44AD" BorderThickness="1"
                            Visibility="{Binding PuedeGestionFacturas, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource NavChipButton}"
                                    Content="Ver cola" Command="{Binding AbrirSolicitudesFlexCommand}"/>
                            <StackPanel>
                                <TextBlock Text="Check-in / check-out especiales" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ResumenFlexPendientes}" FontSize="13" Margin="0,4,0,0"
                                           Foreground="{StaticResource Brush.TextMuted}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource Brush.AccentPastel}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Reservas actuales" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ContadorReservas}" FontSize="12"
                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="3" CornerRadius="14" BorderBrush="{StaticResource Brush.AccentMid}" BorderThickness="1"
                            Background="{StaticResource Brush.SurfaceElevated}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Height="32" VerticalContentAlignment="Center" Margin="0,0,10,0"
                                         ToolTip="ID reserva, habitación, nombre o DNI"
                                         Text="{Binding FiltroReservas, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                                          SelectedValue="{Binding OrdenReservas, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Salida ↑ (más próxima)" Tag="SalidaAsc"/>
                                    <ComboBoxItem Content="Salida ↓ (más lejana)" Tag="SalidaDesc"/>
                                    <ComboBoxItem Content="Entrada ↑" Tag="EntradaAsc"/>
                                    <ComboBoxItem Content="Entrada ↓" Tag="EntradaDesc"/>
                                    <ComboBoxItem Content="Habitación" Tag="Habitacion"/>
                                    <ComboBoxItem Content="Cliente (A-Z)" Tag="Cliente"/>
                                    <ComboBoxItem Content="Retraso salida primero" Tag="Retraso"/>
                                </ComboBox>
                            </Grid>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ReservasActivas}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="8" Padding="0" Cursor="Hand"
                                                Command="{Binding DataContext.AbrirCheckInRecepcionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="228" MinHeight="288" CornerRadius="12"
                                                            BorderThickness="2"
                                                            Background="{StaticResource Brush.CardElevated}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSalidaRetrasada}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#C0392B"/>
                                                                        <Setter Property="Background" Value="#FDEDEC"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid Margin="10">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="100"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" CornerRadius="10" ClipToBounds="True"
                                                        Background="{StaticResource Brush.ImagePlaceholder}">
                                                    <Image Stretch="Uniform"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           MaxWidth="200" MaxHeight="96"
                                                           Source="{Binding RoomImage, Converter={StaticResource ImageUrlConverter}}"/>
                                                </Border>
                                                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding GuestDisplayName}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{StaticResource Brush.TextPrimary}" TextAlignment="Center"
                                                               TextWrapping="Wrap" MaxWidth="190"/>
                                                    <TextBlock Text="{Binding GuestDisplayDni, StringFormat='DNI: {0}'}" FontSize="11"
                                                               HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding reservation_id}" FontSize="11" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource Brush.AccentMid}" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding room_id}" FontSize="11" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource Brush.TextMuted}"/>
                                                    <Border Background="#D5F5E3" CornerRadius="6" Padding="6,3" Margin="0,6,0,0"
                                                            HorizontalAlignment="Center"
                                                            Visibility="{Binding HasReceptionCheckIn, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Check-in ✓" FontSize="10" FontWeight="SemiBold" Foreground="#1E7B34"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding EffectiveCheckIn, StringFormat='Entrada: {0:dd/MM HH:mm}'}"
                                                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource Brush.AccentMid}" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding EffectiveCheckOut, StringFormat='Salida: {0:dd/MM HH:mm}'}"
                                                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding SalidaRetrasoTexto}"
                                                               FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                                                               Foreground="#C0392B" Margin="0,4,0,0"
                                                               Visibility="{Binding IsSalidaRetrasada, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="Pulsar para check-in" FontSize="9" HorizontalAlignment="Center"
                                                               Foreground="{StaticResource Brush.AccentMid}" Margin="0,6,0,0" FontStyle="Italic"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
            </Grid>

            <ContentControl Content="{Binding CurrentPage}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                            Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
        </Grid>
    </DockPanel>
</Window>
