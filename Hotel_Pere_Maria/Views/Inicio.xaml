<Window x:Class="Hotel_Pere_Maria.Views.Inicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria.Views"
        mc:Ignorable="d"
        Title="Inicio" Height="500" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid >
        <DockPanel>

            <Menu DockPanel.Dock="Top" Background="#F5F6F7" Padding="5" BorderBrush="Black" BorderThickness="1">
                <Menu.ItemsPanel>
                    <ItemsPanelTemplate>
                        <DockPanel HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </Menu.ItemsPanel>
                
                <MenuItem Header="Usuarios" FontSize="14" Padding="10,5">
                    <MenuItem Header="Gestionar Usuarios" Command="{Binding AbrirGestionUsuariosCommand}"/>
                </MenuItem>

                <MenuItem Header="Habitaciones" FontSize="14" Padding="10,5">
                    <MenuItem Header="Gestionar Habitaciones" Command="{Binding AbrirAllRoomsCommand}" />
                </MenuItem>

                <MenuItem Header="Reservas" FontSize="14" Padding="10,5">
                    <MenuItem Header="Añadir reserva" Command="{Binding AbrirAddReservaCommand}" />
                    <MenuItem Header="Lista de reservas" Command="{Binding AbrirAllReservasCommand}"/>
                </MenuItem>

                <MenuItem DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Margin="5,0" FontWeight="Bold" Text="{Binding NombreUsuario, StringFormat='Hola, {0}'}"></TextBlock>
                            <Ellipse Width="25" Height="25" Margin="0,0,8,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding ImagenPerfil}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </StackPanel>
                    </MenuItem.Header>
                    <MenuItem Header="Mi perfil" Command="{Binding AbrirPerfilCommand}"></MenuItem>
                    <MenuItem Header="Cerrar Sesión" Command="{Binding CerrarSesionCommand}" FontWeight="Bold" Foreground="#E74C3C"/>
                </MenuItem>
            </Menu>

            <Grid x:Name="MainContent" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Bienvenido al Sistema de Gestión" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="Panel de control de reservas y clientes" FontSize="14" Foreground="Gray"/>
                    </StackPanel>
                    <Button Command="{Binding CargarDatosCommand}" Width="40" Height="40" HorizontalAlignment="Right" Margin="0,0,30,0" Background="Transparent" BorderBrush="Transparent">
                        <Image Source="/Resources/565469 (1).png" ></Image>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="Segoe UI Black" Margin="10">Reservas Actuales</TextBlock>
                </Grid>



                <Border Grid.Row="2" CornerRadius="5" BorderBrush="#FF4A4A4A" BorderThickness="2" Background="#80D4D4D4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Background>
                            <ImageBrush ImageSource="/Resources/HotelLogo.png" Stretch="Uniform" Opacity="0.5"/>
                        </ScrollViewer.Background>
                        <ItemsControl ItemsSource="{Binding ReservasActivas}" Margin="10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5" Height="100" CornerRadius="8" BorderThickness="1" BorderBrush="#999">
                                        <Border.Background>
                                            <SolidColorBrush Color="White"/>
                                        </Border.Background>

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding reservation_id}" FontWeight="Bold" FontSize="20" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding room_id}" FontSize="14" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding check_in,StringFormat='{}E: {0:dd/MM/yyyy HH:mm tt}'}" FontSize="12" HorizontalAlignment="Center" Foreground="Green"/>
                                            <TextBlock Text="{Binding check_out,StringFormat='{}S: {0:dd/MM/yyyy HH:mm tt}'}" FontSize="12" HorizontalAlignment="Center" Foreground="DarkRed"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>

    </Grid>
</Window>
