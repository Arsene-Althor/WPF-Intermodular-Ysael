<Window x:Class="Hotel_Pere_Maria.Views.GestionarDescuento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aplicar Descuento" Height="400" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F5F6F7">

    <Border Background="White" Margin="20" CornerRadius="10" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.2"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Gestionar Descuento" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#2C3E50"/>

            <TextBlock Text="{Binding NombreUsuario}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding TipoTexto}" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#7F8C8D"/>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <CheckBox Content="{Binding VipTexto}"
                      IsChecked="{Binding EsVIP}"
                      IsEnabled="{Binding VipHabilitado}"
                      HorizontalAlignment="Center" Margin="0,0,0,15"
                      FontWeight="Bold" Foreground="#F39C12"/>

            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <Slider Grid.Column="0" Minimum="0"
                        Maximum="{Binding MaxDescuento}"
                        Value="{Binding ValorDescuento}"
                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="{Binding PorcentajeTexto}"
                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="#27AE60"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                <Button Content="Cancelar" Command="{Binding CancelarCommand}" Width="100" Height="30"
                        Background="#95A5A6" Foreground="White" Margin="5"/>
                <Button Content="Guardar" Command="{Binding GuardarCommand}" Width="100" Height="30"
                        Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>