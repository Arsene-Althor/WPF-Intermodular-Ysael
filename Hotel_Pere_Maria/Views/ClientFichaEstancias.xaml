<Window x:Class="Hotel_Pere_Maria.Views.ClientFichaEstancias"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ficha cliente — estancias" Height="720" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.PageBg}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Brush.Surface}" CornerRadius="12" Padding="16" Margin="0,0,12,0"
                BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"/>
                <TextBlock Text="Estadísticas" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                <TextBlock Text="Noches totales" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBlock Text="{Binding StatsNoches}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Gasto total" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBlock Text="{Binding StatsGasto}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Fidelidad" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBlock Text="{Binding StatsTier}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Última estancia" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBlock Text="{Binding StatsUltima}" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding StatsExtra}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                <Button Content="Actualizar" Margin="0,16,0,0" Style="{StaticResource NavChipButton}"
                        Command="{Binding RefrescarCommand}" Padding="12,8"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                    BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                <WrapPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Desde" FontSize="11" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding HistDesde}" Width="130"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Hasta" FontSize="11" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding HistHasta}" Width="130"/>
                    </StackPanel>
                    <Button Content="Filtrar" Style="{StaticResource NavChipButton}" VerticalAlignment="Bottom"
                            Command="{Binding AplicarFiltrosCommand}" Padding="14,8" Margin="0,0,8,0"/>
                    <Button Content="Exportar CSV" Style="{StaticResource NavChipButton}" VerticalAlignment="Bottom"
                            Command="{Binding ExportarCsvCommand}" Padding="14,8"/>
                </WrapPanel>
            </Border>

            <DataGrid Grid.Row="1" ItemsSource="{Binding Historial}" AutoGenerateColumns="False" IsReadOnly="True"
                      RowHeight="40" Background="{StaticResource Brush.Surface}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Reserva" Binding="{Binding reservation_id}" Width="100"/>
                    <DataGridTextColumn Header="Entrada" Binding="{Binding check_in, StringFormat=dd/MM/yyyy}" Width="95"/>
                    <DataGridTextColumn Header="Salida" Binding="{Binding check_out, StringFormat=dd/MM/yyyy}" Width="95"/>
                    <DataGridTextColumn Header="Habitación" Binding="{Binding RoomLabel}" Width="100"/>
                    <DataGridTextColumn Header="Noches" Binding="{Binding nights}" Width="60"/>
                    <DataGridTextColumn Header="Importe" Binding="{Binding total_paid, StringFormat={}{0:N2} €}" Width="85"/>
                    <DataGridTextColumn Header="Valoración" Binding="{Binding RatingLabel}" Width="80"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding status}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <TextBlock Text="{Binding PaginacionLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="◀" Command="{Binding PaginaAnteriorCommand}" Style="{StaticResource NavChipButton}" Padding="10,6" Margin="0,0,6,0"/>
                <Button Content="▶" Command="{Binding PaginaSiguienteCommand}" Style="{StaticResource NavChipButton}" Padding="10,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
