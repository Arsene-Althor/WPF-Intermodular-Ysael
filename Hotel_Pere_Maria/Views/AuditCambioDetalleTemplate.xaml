<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="AuditCambioFilaDetalleTemplate">
        <Border Margin="0,0,0,6" Padding="0" Background="White" CornerRadius="6"
                BorderBrush="#D5DBDB" BorderThickness="1">
            <Grid Margin="4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*" MinWidth="130"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*" MinWidth="130"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Etiqueta}" FontWeight="SemiBold" FontSize="12"
                           Foreground="#2C3E50" VerticalAlignment="Center"
                           Margin="12,10,8,10" TextWrapping="Wrap"/>

                <!-- Solo valor nuevo -->
                <Border Grid.Column="2" Grid.ColumnSpan="3" Background="#E8F8F0" CornerRadius="6"
                        Margin="0,8,12,8" Padding="12,10" BorderBrush="#A9DFBF" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsSoloAlta}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="VALOR NUEVO" FontSize="10" FontWeight="Bold" Foreground="#1E8449" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Despues}" FontSize="12" LineHeight="18"
                                   TextWrapping="Wrap" Foreground="#2C3E50"/>
                    </StackPanel>
                </Border>

                <!-- Solo eliminación -->
                <Border Grid.Column="2" Grid.ColumnSpan="3" Background="#FDEDEC" CornerRadius="6"
                        Margin="0,8,12,8" Padding="12,10" BorderBrush="#F5B7B1" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsSoloBaja}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="VALOR ELIMINADO" FontSize="10" FontWeight="Bold" Foreground="#922B21" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Antes}" FontSize="12" LineHeight="18"
                                   TextWrapping="Wrap" Foreground="#2C3E50"/>
                    </StackPanel>
                </Border>

                <!-- Antes / después habitual -->
                <Border Grid.Column="2" Background="#FDEDEC" CornerRadius="6"
                        Margin="0,8,0,8" Padding="12,10" BorderBrush="#F5B7B1" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsSoloAlta}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EsSoloBaja}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="ANTES" FontSize="10" FontWeight="Bold" Foreground="#922B21" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Antes}" FontSize="12" LineHeight="18"
                                   TextWrapping="Wrap" Foreground="#2C3E50"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="#E8F8F0" CornerRadius="6"
                        Margin="0,8,12,8" Padding="12,10" BorderBrush="#A9DFBF" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsSoloAlta}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EsSoloBaja}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="DESPUÉS" FontSize="10" FontWeight="Bold" Foreground="#1E8449" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Despues}" FontSize="12" LineHeight="18"
                                   TextWrapping="Wrap" Foreground="#2C3E50"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
