<UserControl x:Class="Hotel_Pere_Maria.Views.listAuditorias"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d" d:DesignHeight="640" d:DesignWidth="1100" Background="Transparent">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceSubtle}" CornerRadius="10" Padding="12,10" Margin="0,0,0,16"
                BorderBrush="{StaticResource Brush.AccentMid}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextPrimary}" Text="Auditoría de reservas (global)"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Recargar desde API" Style="{StaticResource NavChipButton}" Padding="14,8" Margin="0,0,8,0"
                            Command="{Binding CargarCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" CornerRadius="12" Padding="15" Margin="0,0,0,16"
                BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Filtros de carga (servidor) y filtro local" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                <UniformGrid Columns="4">
                    <StackPanel Margin="5">
                        <TextBlock Text="Reserva (booking_id)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FiltroReserva, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Actor (user_id)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FiltroActor, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Acción (CREATED/UPDATED/CANCELED)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FiltroAccion, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Buscar en tabla (texto libre)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="Tras cambiar los tres primeros campos, pulsa «Recargar desde API». El cuarto filtra la tabla ya cargada."
                           FontSize="11" Foreground="{StaticResource Brush.TextMuted}" Margin="5,8,0,0" TextWrapping="Wrap"/>
                <Button Content="Limpiar filtros de carga" HorizontalAlignment="Left" Margin="5,10,0,0"
                        Style="{StaticResource NavChipButton}" Command="{Binding LimpiarFiltrosCommand}" Padding="12,6"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" CornerRadius="12" Padding="8"
                BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Filas}" AutoGenerateColumns="False" IsReadOnly="True"
                      RowHeight="40" GridLinesVisibility="Horizontal" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTxt}" Width="150"/>
                    <DataGridTextColumn Header="Reserva" Binding="{Binding ReservaId}" Width="120"/>
                    <DataGridTextColumn Header="Acción" Binding="{Binding Accion}" Width="110"/>
                    <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="220"/>
                    <DataGridTextColumn Header="Resumen cambios" Binding="{Binding Resumen}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
