<Window x:Class="Hotel_Pere_Maria.Views.InsertarUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datos del Usuario" Height="550" Width="600"
        WindowStartupLocation="CenterScreen" Background="#F5F6F7">

    <Border Background="White" Margin="20" CornerRadius="10" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.2"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="Formulario de Usuario" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5">
                <TextBlock Text="Nombre:"/>
                <TextBox x:Name="txtNombre" Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,5">
                <TextBlock Text="DNI:"/>
                <TextBox x:Name="txtDNI" Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,5">
                <TextBlock Text="Email:"/>
                <TextBox x:Name="txtEmail" Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,5">
                <TextBlock Text="Ciudad:"/>
                <ComboBox x:Name="cbCiudad" Padding="5">
                    <ComboBoxItem Content="Benidorm"/>
                    <ComboBoxItem Content="Alicante"/>
                    <ComboBoxItem Content="Valencia"/>
                    <ComboBoxItem Content="Madrid"/>
                    <ComboBoxItem Content="Otro"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,5">
                <TextBlock Text="Apellidos:"/>
                <TextBox x:Name="txtApellido" Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,5">
                <TextBlock Text="Rol:"/>
                <ComboBox x:Name="cbRol" Padding="5" SelectionChanged="cbRol_SelectionChanged">
                    <ComboBoxItem Content="client" IsSelected="True"/>
                    <ComboBoxItem Content="employee"/>
                    <ComboBoxItem Content="admin"/>
                </ComboBox>

            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,5">
                <TextBlock Text="Contraseña:"/>
                <PasswordBox x:Name="txtPass" Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,5">
                <TextBlock Text="Confirmar Contraseña:"/>
                <PasswordBox x:Name="txtPassConfirm" Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,15">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Fecha Nacimiento:"/>
                    <DatePicker x:Name="dpFechaNacimiento" Width="150"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Sexo:"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="rbHombre" Content="Hombre" Margin="5"/>
                        <RadioButton x:Name="rbMujer" Content="Mujer" Margin="5"/>
                        <RadioButton x:Name="rbOtro" Content="Otro" Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Click="Click_Cancelar" Width="100" Height="35" Background="Gray" Foreground="White" Margin="10,0"/>
                <Button Content="Guardar" Click="Click_Guardar" Width="100" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>