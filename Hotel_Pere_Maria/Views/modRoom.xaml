<Window x:Class="Hotel_Pere_Maria.Views.modRoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestión de habitación" Height="720" Width="820">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Gestión de habitación"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16"
                   FontFamily="Segoe UI Black"/>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="1"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                <StackPanel>
                    <TextBlock Text="Room ID" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox Height="30"
                             IsReadOnly="{Binding IsRoomIdReadOnly}"
                             Text="{Binding RoomId, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Tipo" FontSize="11" Margin="0,0,0,3"/>
                            <ComboBox Height="30"
                                      SelectedValuePath="Content"
                                      SelectedValue="{Binding Type}">
                                <ComboBoxItem Content="Individual"/>
                                <ComboBoxItem Content="Doble"/>
                                <ComboBoxItem Content="Suite"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Precio base / noche (tarifa)" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox Height="30"
                                     Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Máx. ocupación" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox Height="30" Text="{Binding MaxOccupancy}" IsReadOnly="True" Background="#F0F0F0" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Valoración (rate)" FontSize="11" Margin="0,0,0,3"/>
                            <TextBox Height="30" VerticalContentAlignment="Center"
                                     Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsRateReadOnly}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRateReadOnly}" Value="True">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                                <Setter Property="ToolTip" Value="La valoración (rate) solo la modifica un administrador."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </Grid>

                    <CheckBox Margin="0,16,0,0" Content="Oferta activa (descuento % sobre precio base; la app muestra precio rebajado)"
                              IsChecked="{Binding OfferActive}"/>
                    <TextBlock Text="% descuento (0–100)" FontSize="11" Margin="0,8,0,3"/>
                    <TextBox Height="30" Text="{Binding OfferPercent, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Galería (URLs, una por fila; en la app: carrusel)" FontSize="11" Margin="0,16,0,6" FontWeight="SemiBold"/>
                    <ListBox ItemsSource="{Binding ImageUrls}" Height="110" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Quitar" Width="56" Margin="8,0,0,0"
                                            Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBox Height="30" Margin="0,0,0,6"
                             Text="{Binding NewImageUrl, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             ToolTip="Pega una URL https://…"/>
                    <Button Content="Añadir URL a la galería" Command="{Binding AddImageCommand}" HorizontalAlignment="Left" Padding="12,4"/>

                    <TextBlock Text="Servicios extra (catálogo API)" FontSize="11" Margin="0,16,0,6" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding ServicePicks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,4,0,0" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Nuevo servicio en catálogo (todas las habitaciones podrán asignarlo)" FontSize="11" Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="30" Margin="0,0,8,0"
                                 Text="{Binding NewServiceName, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Crear servicio" Command="{Binding CreateCatalogServiceCommand}" Padding="12,4"/>
                    </Grid>

                    <TextBlock Text="Descripción" FontSize="11" Margin="0,16,0,3"/>
                    <TextBox Height="90"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <CheckBox Margin="0,12,0,0"
                              Content="Habitación en servicio (visible en app cliente si cumple fechas/capacidad)"
                              IsChecked="{Binding IsOperational}"/>

                    <TextBlock x:Name="txtMsg"
                               Foreground="#E74C3C"
                               FontSize="12"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Guardar" Width="120" Height="35" Margin="0,0,10,0"
                    Background="#2ECC71" Foreground="White" FontWeight="Bold"
                    Command="{Binding SaveCommand}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Cancelar" Width="120" Height="35"
                    Background="#E74C3C" Foreground="White" FontWeight="Bold"
                    Click="BtnCancelar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
