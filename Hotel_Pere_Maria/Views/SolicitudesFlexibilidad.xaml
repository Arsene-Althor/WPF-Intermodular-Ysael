<UserControl x:Class="Hotel_Pere_Maria.Views.SolicitudesFlexibilidad"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="720" d:DesignWidth="1100"
        MinHeight="640" MinWidth="900"
        Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="SolicitudFlexFilaTemplate">
            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,10"
                    BorderBrush="#D5DBDB" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontWeight="Bold" FontSize="15">
                            <Run Text="{Binding ReservationId, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding TipoTexto, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#7F8C8D">
                            <Run Text="Registrada: "/>
                            <Run Text="{Binding FechaOrden, StringFormat='{}{0:dd/MM/yyyy HH:mm}', Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" FontSize="12">
                            <Run Text="Habitación: " FontWeight="SemiBold"/>
                            <Run Text="{Binding RoomId, Mode=OneWay}"/>
                            <Run Text="  Cliente: "/>
                            <Run Text="{Binding UserId, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="12">
                            <Run Text="Hora solicitada: " FontWeight="SemiBold"/>
                            <Run Text="{Binding HoraSolicitada, Mode=OneWay}"/>
                            <Run Text="  Fidelidad: "/>
                            <Run Text="{Binding RangoFidelidad, Mode=OneWay}"/>
                            <Run Text="  Suplemento: "/>
                            <Run Text="{Binding Tarifa, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Disponibilidad, StringFormat='Disponibilidad: {0}'}"
                                   FontSize="11" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding EstadoTexto, StringFormat='Estado: {0}'}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#5B2C6F" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Ver motivo" Margin="0,0,8,0" Padding="12,6" Cursor="Hand"
                                Command="{Binding VerMotivoCommand}"
                                Visibility="{Binding TieneMotivoRechazo, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Ver reserva" Margin="0,0,8,0" Padding="12,6" Cursor="Hand"
                                Command="{Binding AbrirReservaCommand}"/>
                        <Button Content="Aprobar" Background="#27AE60" Foreground="White" Padding="12,6" Margin="0,0,6,0"
                                Command="{Binding AprobarCommand}"
                                Visibility="{Binding PuedeRevisar, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Rechazar" Background="#C0392B" Foreground="White" Padding="12,6"
                                Command="{Binding RechazarCommand}"
                                Visibility="{Binding PuedeRevisar, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid MinHeight="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceSubtle}" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                BorderBrush="{StaticResource Brush.AccentMid}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Solicitudes del día"/>
                    <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource Brush.TextMuted}"
                               Text="{Binding Resumen}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Día:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding FechaDia, Mode=TwoWay}" Width="130" Margin="0,0,12,0"/>
                    <Button Content="{Binding OrdenToggleTexto}" Style="{StaticResource NavChipButton}"
                            Command="{Binding AlternarOrdenCommand}" Margin="0,0,8,0"/>
                    <Button Content="Actualizar" Style="{StaticResource NavChipButton}" Command="{Binding CargarCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Activas">
                <Border Background="{StaticResource Brush.SurfaceElevated}" CornerRadius="12" Padding="12"
                        BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="No hay solicitudes activas para este día."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="14" Foreground="{StaticResource Brush.TextMuted}"
                                   Visibility="{Binding SinActivas, Converter={StaticResource BoolToVis}}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520"
                                      Visibility="{Binding SinActivas, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <ItemsControl ItemsSource="{Binding FilasActivas}" ItemTemplate="{StaticResource SolicitudFlexFilaTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Inactivas">
                <Border Background="{StaticResource Brush.SurfaceElevated}" CornerRadius="12" Padding="12"
                        BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="No hay solicitudes inactivas para este día."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="14" Foreground="{StaticResource Brush.TextMuted}"
                                   Visibility="{Binding SinInactivas, Converter={StaticResource BoolToVis}}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520"
                                      Visibility="{Binding SinInactivas, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <ItemsControl ItemsSource="{Binding FilasInactivas}" ItemTemplate="{StaticResource SolicitudFlexFilaTemplate}"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
