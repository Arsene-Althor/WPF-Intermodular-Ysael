<Window x:Class="Hotel_Pere_Maria.Views.SelectedUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SelectedUser" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F5F6F7">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border>
            <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" FontFamily="Segoe UI Black">Listado de Usuarios</TextBlock>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Filtros de Búsqueda" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" Foreground="#2C3E50"/>

                <UniformGrid Columns="5">
                    <StackPanel Margin="5">
                        <TextBlock Text="ID Usuario" FontSize="11" Margin="0,0,0,3" FontWeight="SemiBold"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FiltroIdUser, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="DNI" FontSize="11" Margin="0,0,0,3" FontWeight="SemiBold"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FiltroDNI, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Nombre" FontSize="11" Margin="0,0,0,3" FontWeight="SemiBold"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Apellido" FontSize="11" Margin="0,0,0,3" FontWeight="SemiBold"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FiltroApellido, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Email" FontSize="11" Margin="0,0,0,3" FontWeight="SemiBold"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FiltroEmail, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </UniformGrid>
                <Button Content="Limpiar" Command="{Binding LimpiarFiltrosCommand}"
                        Width="80" Height="35" VerticalAlignment="Bottom" Margin="5"
                        Background="#E74C3C" Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="1" ShadowDepth="1"/>
            </Border.Effect>
            <DataGrid x:Name="dgUsuarios" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#F0F0F0"
                  RowHeight="40"
                  Background="White"
                  BorderThickness="0"
                  ItemsSource="{Binding UsuariosFiltrados}"
                  SelectedItem="{Binding UsuarioSeleccionado}"
                  MouseDoubleClick="dbClick_SelectUser">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#34495E"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Height" Value="40"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID Usuario" Binding="{Binding user_id}" Width="*" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="DNI" Binding="{Binding dni}" Width="*"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding name}" Width="*"/>
                    <DataGridTextColumn Header="Apellido" Binding="{Binding surname}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding email}" Width="*"/>
                    <DataGridTextColumn Header="Descuento" Binding="{Binding discont, StringFormat={}{0:N2}€}" Width="*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding role}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
