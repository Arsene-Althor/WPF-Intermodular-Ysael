<UserControl x:Class="Hotel_Pere_Maria.Views.addReserva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="600" d:DesignWidth="520"
        Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8">
        <Border Background="{StaticResource Brush.Surface}" CornerRadius="12" Padding="24" Margin="0,0,0,8"
                BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1" MaxWidth="440" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Nueva reserva" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"
                           Foreground="{StaticResource Brush.TextPrimary}"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Check-In" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"/>
                        <DatePicker SelectedDate="{Binding CheckIn, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Check-Out" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"/>
                        <DatePicker SelectedDate="{Binding CheckOut, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Número de habitación" Margin="0,16,0,5" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"/>

                <TextBox Padding="8" Text="{Binding RoomId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding FechasValidas}">
                    <TextBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SeleccionarHabitacionCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="Cliente" Margin="0,12,0,5" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBox Padding="8" Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding FechasValidas}">
                    <TextBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SeleccionarClienteCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="Precio estimado" Margin="0,16,0,4" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}"/>
                <TextBlock Text="{Binding PrecioReserva, StringFormat={}{0:N2}€}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.AccentPastelDeep}" HorizontalAlignment="Center"/>

                <TextBlock Text="Forma de pago" Margin="0,14,0,5" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextMuted}"/>

                <ComboBox x:Name="cbFormaPago" SelectedIndex="0" Padding="8">
                    <ComboBoxItem Content="Tarjeta de Crédito"/>
                    <ComboBoxItem Content="Efectivo"/>
                    <ComboBoxItem Content="Transferencia Bancaria"/>
                </ComboBox>

                <Button Command="{Binding ConfirmarCommand}" Content="Confirmar reserva" Margin="0,28,0,0" Padding="14,10"
                        Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
