<UserControl x:Class="Hotel_Pere_Maria.Views.listFacturas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DesignHeight="640" d:DesignWidth="1100"
        Background="Transparent">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceSubtle}" CornerRadius="10" Padding="12,10" Margin="0,0,0,16"
                BorderBrush="{StaticResource Brush.AccentMid}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextPrimary}" Text="Facturas (PDF emitidos)"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Actualizar" Style="{StaticResource NavChipButton}" Padding="14,8" Margin="0,0,8,0"
                            Command="{Binding RefrescarCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Brush.Surface}" CornerRadius="12" Padding="15" Margin="0,0,0,16"
                BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Filtros" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,12"/>
                <UniformGrid Columns="4">
                    <StackPanel Margin="5">
                        <TextBlock Text="Nº factura" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FiltroFactura, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Cliente (user_id)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox Height="30" VerticalContentAlignment="Center"
                                 Text="{Binding FiltroCliente, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding SeleccionarClienteFiltroCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Checkout desde" FontSize="11" FontWeight="SemiBold"/>
                        <DatePicker Margin="0,5,0,0" SelectedDate="{Binding CheckoutDesde}"/>
                    </StackPanel>
                    <StackPanel Margin="5">
                        <TextBlock Text="Checkout hasta" FontSize="11" FontWeight="SemiBold"/>
                        <DatePicker Margin="0,5,0,0" SelectedDate="{Binding CheckoutHasta}"/>
                    </StackPanel>
                </UniformGrid>
                <Button Content="Limpiar filtros" HorizontalAlignment="Left" Margin="5,10,0,0"
                        Style="{StaticResource NavChipButton}" Command="{Binding LimpiarFiltrosCommand}" Padding="12,6"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Brush.Surface}" CornerRadius="12" Padding="8"
                BorderBrush="{StaticResource Brush.AccentBorder}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding FacturasFiltradas}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      RowHeight="44"
                      GridLinesVisibility="Horizontal"
                      Background="{StaticResource Brush.Surface}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Factura" Binding="{Binding invoice_number}" Width="140" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Reserva" Binding="{Binding reservation_id}" Width="110"/>
                    <DataGridTextColumn Header="Cliente" Binding="{Binding user_id}" Width="110"/>
                    <DataGridTextColumn Header="Habitación" Binding="{Binding room_id}" Width="100"/>
                    <DataGridTextColumn Header="Checkout" Binding="{Binding checkout_completed_at, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                    <DataGridTextColumn Header="Importe" Binding="{Binding price, StringFormat={}{0:N2} €}" Width="90"/>
                    <DataGridTemplateColumn Header="PDF" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Descargar" Style="{StaticResource NavChipButton}" Padding="8,4"
                                        Command="{Binding DataContext.DescargarPdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Email" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Reenviar" Style="{StaticResource NavChipButton}" Padding="8,4"
                                        Command="{Binding DataContext.ReenviarEmailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
