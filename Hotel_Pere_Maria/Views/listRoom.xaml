<Window x:Class="Hotel_Pere_Maria.Views.listRoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria.Views"
        mc:Ignorable="d"
        Title="listRoom" Height="450" Width="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO (igual que el estilo bueno) -->
        <Border>
            <TextBlock Name="txtInfo"
                   Text="Listado de Habitaciones"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   FontFamily="Segoe UI Black"/>
        </Border>

        <!-- FILTROS (CARD estilo reservas/rooms) -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="1"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Filtros de Búsqueda"
                       FontWeight="Bold"
                       FontSize="14"
                       Foreground="#2C3E50"
                       Margin="0,0,0,15"/>

                <!-- Fila 1 (4 columnas) -->
                <UniformGrid Columns="4">
                    <StackPanel Margin="5">
                        <TextBlock Text="ID Habitación" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtIdRoom"
                             Height="30"
                             VerticalContentAlignment="Center"
                             TextChanged="Filtros_Changed"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Tipo (Individual/Doble/Matrimonio...)" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtTipo"
                             Height="30"
                             VerticalContentAlignment="Center"
                             TextChanged="Filtros_Changed"/>
                    </StackPanel>

                    <StackPanel Margin="5" VerticalAlignment="Center">
                        <CheckBox x:Name="chkSoloDisponibles"
                              Content="Solo disponibles"
                              VerticalAlignment="Center"
                              Margin="0,15,0,0"
                              Checked="Filtros_Changed"
                              Unchecked="Filtros_Changed"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Fila 2 + Botón limpiar -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="Capacidad mínima" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtCapMin"
                             Height="30"
                             VerticalContentAlignment="Center"
                             TextChanged="Filtros_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="Precio mín." FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtPrecioMin"
                             Height="30"
                             VerticalContentAlignment="Center"
                             TextChanged="Filtros_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="5">
                        <TextBlock Text="Precio máx." FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="txtPrecioMax"
                             Height="30"
                             VerticalContentAlignment="Center"
                             TextChanged="Filtros_Changed"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                        Content="Limpiar"
                        Click="BtnLimpiar_Click"
                        Width="80"
                        Height="35"
                        VerticalAlignment="Bottom"
                        Margin="5"
                        Background="#E74C3C"
                        Foreground="White"
                        FontWeight="Bold">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- TABLA (CARD estilo reservas/rooms) -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="1"/>
            </Border.Effect>

            <DataGrid x:Name="dgRooms"
                  MouseDoubleClick="dgRooms_MouseDoubleClick"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#F0F0F0"
                  RowHeight="40"
                  Background="White"
                  BorderThickness="0"
                  Margin="0">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#34495E"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Height" Value="40"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding RoomId}" Width="*"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="*"/>
                    <DataGridTextColumn Header="Máx. Ocup." Binding="{Binding MaxOccupancy}" Width="*"/>
                    <DataGridTextColumn Header="Precio/Noche" Binding="{Binding PricePerNight}" Width="*"/>
                    <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Disponible" Binding="{Binding IsAvailable}" Width="*"/>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>

</Window>
