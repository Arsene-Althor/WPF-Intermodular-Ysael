<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Hotel_Pere_Maria.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <conv:ImageUrlConverter x:Key="ImageUrlConverter"/>

    <SolidColorBrush x:Key="Brush.PageBg" Color="#E4EEF6"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceSubtle" Color="#EDF5FC"/>
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#F4FAFF"/>
    <SolidColorBrush x:Key="Brush.CardElevated" Color="#F7FBFF"/>
    <SolidColorBrush x:Key="Brush.ImagePlaceholder" Color="#D0E4F4"/>
    <SolidColorBrush x:Key="Brush.NavChipIdle" Color="#D4E8F6"/>
    <SolidColorBrush x:Key="Brush.AccentPastel" Color="#B8D4EA"/>
    <SolidColorBrush x:Key="Brush.AccentPastelDeep" Color="#7EB3D8"/>
    <SolidColorBrush x:Key="Brush.AccentMid" Color="#5A9BC8"/>
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#A8C9E0"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1E3A4F"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#5D7A92"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FADBD8"/>

    <LinearGradientBrush x:Key="Brush.PanelWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5FAFF" Offset="0"/>
        <GradientStop Color="#E2EDF7" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Brush.PageBg}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style x:Key="NavChipButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.NavChipIdle}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdNav" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdNav" Property="Background" Value="{StaticResource Brush.AccentPastel}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.AccentMid}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentPastelDeep}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdPrimary" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdPrimary" Property="Background" Value="{StaticResource Brush.AccentPastelDeep}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource NavChipButton}">
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentBorder}"/>
    </Style>
</ResourceDictionary>

